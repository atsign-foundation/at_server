# VERSION is the release being promoted, such as 3.19.0
ARG VERSION
FROM atsigncompany/ephemeral:canary-c${VERSION} AS canary

# latest reports the canary's version without the +c<tag> suffix the canary
# build adds
FROM --platform=$BUILDPLATFORM debian:stable-20261027-slim@sha256:13e0a2e78aa0554ad5ff66e4e260c6dbcdff807eb1f39d43b9fb0288aae88b04 AS version
ARG VERSION
COPY --from=canary /atsign/secondary/pubspec.yaml /pubspec.yaml
RUN \
  if ! grep -Fqx "version: ${VERSION}+c${VERSION}" /pubspec.yaml; then \
    echo "Expected version: ${VERSION}+c${VERSION}, found $(grep '^version:' /pubspec.yaml)" ; \
    exit 1 ; \
  fi && \
  sed -i "0,/^version:/ s/^version:.*/version: ${VERSION}/" /pubspec.yaml && \
  grep '^version:' /pubspec.yaml

FROM canary
# If building manually then (from the repo root):
## docker buildx build --build-arg VERSION=3.19.0 -t atsigncompany/ephemeral \
## -f tools/build_ephemeral_environment/ee_base/Dockerfile.canary_to_latest .
COPY --from=version --chown=atsign:atsign /pubspec.yaml /atsign/secondary/
