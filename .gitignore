# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/

# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock
pubspec_overrides.yaml

# But we do want pubspec.lock for at_root_server and at_secondary_server
!packages/at_root_server/pubspec.lock
!packages/at_secondary_server/pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# Avoid committing generated Javascript files:
*.dart.js
*.info.json      # Produced by the --dump-info flag.
*.js             # When generated by dart2js. Don't specify *.js if your
                 # project includes source files written in JavaScript.
*.js_
*.js.deps
*.js.map

# IntelliJ related
*.iml
*.ipr
*.iws
*.idea/
@*
*/certs/*
.vscode/
storage


packages/at_root_server/certs
packages/at_root_server/redis.log
packages/at_root_server/root
packages/at_root_server/runLocal.sh
packages/at_secondary_server/bin/create_ws_to_at_server.dart
packages/at_secondary_server/secondary
tests/at_end2end_test/config/config.yaml

